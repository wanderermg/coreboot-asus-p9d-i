## SPDX-License-Identifier: GPL-2.0-only

chip northbridge/intel/haswell
	# Confirmed by full PEI SPD reads: DIMM_A1=0x50, DIMM_B1=0x52.
	register "spd_addresses" = "{0x50, 0, 0x52, 0}"
	chip cpu/intel/haswell
		device cpu_cluster 0 on ops haswell_cpu_bus_ops end
	end
	device domain 0 on
		ops haswell_pci_domain_ops
		device pci 00.0 on end
		device pci 01.0 on end # CPU PEG -> NVMe
		device pci 01.1 off end
		device pci 01.2 off end
		device pci 02.0 off end
		device pci 03.0 off end
		chip southbridge/intel/lynxpoint
			register "sata_port_map" = "0x0f"
			# Original LPC windows; normalize ignored GEN1 address bit 2.
			register "gen1_dec" = "LPC_IO(0x290, 0x10)"
			register "gen2_dec" = "LPC_IO(0xca0, 0x10)"
			device pci 14.0 on end
			device pci 16.0 on end
			device pci 16.1 on end
			device pci 16.2 off end
			device pci 16.3 off end
			device pci 19.0 off end
			device pci 1a.0 on end
			device pci 1b.0 off end
			device pci 1c.0 on # I210
				device pci 00.0 on end
			end
			device pci 1c.1 on # I210
				device pci 00.0 on end
			end
			device pci 1c.2 on # ASPEED bridge -> AST2300
				device pci 00.0 on
					device pci 00.0 on end
				end
			end
			device pci 1c.3 off end
			device pci 1c.4 off end
			device pci 1c.5 off end
			device pci 1c.6 off end
			device pci 1c.7 off end
			device pci 1d.0 on end
			device pci 1f.0 on
				chip superio/nuvoton/nct6779d
					device pnp 2e.2 on
						io 0x60 = 0x3f8
						irq 0x70 = 4
					end
					device pnp 2e.3 on
						io 0x60 = 0x2f8
						irq 0x70 = 3
					end
					# HWM address inferred from original LPC decode;
					# monitor.c restores measured SMBus pins/CPUTIN type; no fan curves.
					device pnp 2e.b on
						io 0x60 = 0x290
						io 0x62 = 0
						irq 0x70 = 0
					end
					# Stock LDN16 CR30=0x20: keep Deep S5 off for standby BMC power.
					# Unlisted PNP functions otherwise default to enabled (CR30 bit0).
					device pnp 2e.16 off end
				end
				chip drivers/ipmi
					register "bmc_i2c_address" = "0x10"
					register "wait_for_bmc" = "true"
					register "bmc_boot_timeout" = "60"
					device pnp ca2.0 on end
				end
			end
			device pci 1f.2 on end
			device pci 1f.3 on end
			device pci 1f.5 off end
			device pci 1f.6 on end
		end
	end
end
